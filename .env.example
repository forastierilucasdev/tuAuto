# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el archivo .env (con valores reales) al repositorio.

# --- Base de datos (Supabase Postgres) ---
# Connection string "Transaction pooler" (puerto 6543) de tu proyecto Supabase.
# Project Settings -> Database -> Connection string -> Transaction pooler.
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connection string "Session pooler" o directa (puerto 5432), usada solo para migraciones.
DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres"

# --- Autenticación (Auth.js) ---
# Generar con: npx auth secret
AUTH_SECRET=""

# --- Supabase Storage (fotos de publicaciones) ---
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
# No se usa por ahora (la app usa Prisma + service role key), se documenta por si hace falta a futuro.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# --- Mercado Pago (integracion real pendiente, ver ARCHITECTURE.md) ---
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_PUBLIC_KEY=""
