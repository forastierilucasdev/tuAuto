# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el archivo .env (con valores reales) al repositorio.

# --- Base de datos (Supabase Postgres) ---
# Connection string "Transaction pooler" (puerto 6543) de tu proyecto Supabase.
# Project Settings -> Database -> Connection string -> Transaction pooler.
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connection string "Session pooler" o directa (puerto 5432), usada solo para migraciones.
DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres"

# --- Autenticación (Auth.js) ---
# Generar con: npx auth secret
AUTH_SECRET=""

# --- Supabase Storage (fotos de publicaciones) ---
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
# No se usa por ahora (la app usa Prisma + service role key), se documenta por si hace falta a futuro.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# --- Mercado Pago (Checkout Pro, ver ARCHITECTURE.md) ---
# Access Token + Public Key: developers.mercadopago.com -> Tus integraciones
# -> la app -> Credenciales (de prueba o de producción).
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_PUBLIC_KEY=""
# Firma del webhook: developers.mercadopago.com -> la app -> Webhooks ->
# configurar la URL (https://tu-dominio/api/mercadopago/webhook) -> "Firma
# secreta". Sin esta variable, el webhook procesa igual las notificaciones
# pero sin validar que vengan realmente de Mercado Pago (con un warning).
MERCADOPAGO_WEBHOOK_SECRET=""

# --- Envío de emails (Resend, para "Soporte" — reporte de errores) ---
# API Key gratis en https://resend.com (Dashboard -> API Keys). Sin esta
# variable, el formulario de Soporte muestra un error explícito en vez de
# fallar en silencio. Ver src/lib/resend.ts y ARCHITECTURE.md.
RESEND_API_KEY=""
# Remitente verificado en Resend (Domains -> verificar motoresya.com.ar).
# Sin dominio propio verificado, Resend solo deja mandar desde
# "onboarding@resend.dev" (y solo a la casilla de tu cuenta de Resend) — es
# el default si dejás esto vacío.
RESEND_FROM_EMAIL=""

# --- Rate limiting distribuido (opcional) ---
# Base de Redis gratuita en https://upstash.com (Create database -> Details
# -> REST API). Sin estas dos variables, el rate limiting cae a un Map
# in-memory por proceso (sirve para desarrollo, no para producción con más
# de una instancia). Ver src/lib/rate-limit.ts y ARCHITECTURE.md.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
