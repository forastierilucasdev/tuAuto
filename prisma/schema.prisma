generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  PARTICULAR
  AGENCIA
  CONCESIONARIA
}

enum ListingStatus {
  DRAFT
  ACTIVE
  RESERVADA
  PAUSADA
  EXPIRED
  SOLD
  // Suspendida por un admin (`suspendedUntil` vigente) — nunca se escribe
  // en esta columna, es un valor 100% computado por `getEffectiveStatus()`
  // (mismo criterio que ya usa EXPIRED), ver `server/data/listings.ts`.
  SUSPENDIDA
  // Tiene marca/modelo/versión y/o localidad tecleados a mano (no están en
  // el catálogo todavía, ver `TaxonomyRequest`/`LocalityRequest`) — inactiva,
  // invisible en el catálogo, no consume cupo. El admin aprueba la solicitud
  // de catálogo (deja los datos reales resueltos) y después "Valida datos"
  // esta publicación puntual (dos pasos separados) para que recién ahí pase
  // a ACTIVE y se descuente el crédito — ver `validateAndActivateListing`.
  PENDIENTE_APROBACION
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Currency {
  ARS
  USD
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VehicleCondition {
  NUEVO
  USADO
}

enum TransmissionType {
  MECANICA
  ASISTIDA
}

// Null = no es admin. Los 3 roles del panel /admin — ver `lib/admin-permissions.ts`
// para la matriz de qué puede hacer cada uno en cada módulo.
enum AdminRole {
  SUPERADMIN
  EDITOR
  LECTOR
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  accountType  AccountType
  fullName     String
  dni          String      @unique
  phone        String
  avatarUrl    String?
  // Punto de anclaje del recorte (`object-position`, 0-100) que el usuario
  // elige arrastrando la imagen en el selector — la foto siempre se muestra
  // con `object-fit: cover`, esto solo mueve qué parte queda visible.
  // Default 50/50 = centrado, mismo comportamiento que antes de esta función.
  avatarPositionX Int      @default(50)
  avatarPositionY Int      @default(50)
  isActive     Boolean     @default(true)
  lastLoginAt  DateTime?

  // "Publicaciones realizadas": suma 1 una única vez por publicación, la
  // primera vez que se publica de verdad (alta directa o borrador→publicar)
  // — reactivar la MISMA publicación (reservada/pausada/vencida) nunca la
  // vuelve a sumar.
  activationCount Int @default(0)

  // Cupo real consumido: además del primer publish de cada aviso, también
  // suma cuando una publicación vencida se reactiva (empieza un ciclo
  // nuevo) — a diferencia de reactivar desde reservada/pausada, que es
  // gratis. "Publicaciones disponibles" = FREE_PUBLICATION_QUOTA +
  // purchasedPublications - quotaConsumed (ver `server/data/listings.ts`).
  quotaConsumed         Int     @default(0)
  purchasedPublications Int     @default(0)
  isVerified            Boolean @default(false)

  // Cupo temporal de una suscripción activa (Suscripciones, 5/10/30
  // publicaciones por 30 días): a diferencia de `purchasedPublications`
  // (permanente), este cupo se pierde si `subscriptionExpiresAt` pasó sin
  // comprar una suscripción nueva — no hay proceso en segundo plano, se
  // descuenta al leer (ver `getAvailablePublications`). Comprar una
  // suscripción nueva reemplaza estos dos campos, no se acumulan.
  subscriptionQuota     Int       @default(0)
  subscriptionExpiresAt DateTime?
  // Qué plan es la suscripción vigente — solo para mostrar el nombre
  // ("Suscripción: 30 publicaciones por 30 días — vence..."), nunca se lee
  // para calcular cupo (eso sigue siendo `subscriptionQuota`). No se limpia
  // al cancelar/vencer: queda como referencia histórica, sin efecto porque
  // la UI solo lo muestra cuando `subscriptionExpiresAt` sigue vigente.
  subscriptionPlanCode String?

  // Créditos de "destacar" pendientes de aplicar: se suman al comprar
  // "Publicación 30 días + 7 días destacado" eligiendo "aplicar a la próxima
  // publicación" (en vez de a una publicación existente) — se consumen solos
  // en la próxima publicación/reactivación (ver `loadActivationContext`).
  pendingFeaturedVouchers Int @default(0)
  // Contadores históricos (nunca decrecen, a diferencia de `pendingFeaturedVouchers`
  // que es el saldo vivo) — solo para mostrar "comprados"/"utilizados" por separado.
  featuredVouchersGranted Int @default(0)
  featuredVouchersUsed    Int @default(0)

  // Se incrementa al cambiar la contraseña — el JWT de sesión guarda el
  // valor vigente al loguearse, así que un cambio de contraseña invalida
  // cualquier sesión previa (robada o no) en el próximo request, sin
  // necesitar una tabla de sesiones server-side. Ver `lib/auth.ts`.
  sessionVersion Int @default(0)

  // Panel de administración (`/admin`) — null para el 99% de las cuentas
  // (usuarios normales del marketplace). `deletedAt` es borrado lógico: la
  // fila sigue en la base, pero se excluye de toda lectura pública/del
  // dueño (login incluido, ver `getSessionState`) — nunca un DELETE real.
  adminRole AdminRole?
  deletedAt DateTime?

  // Bloqueo por intentos fallidos — solo se escriben para cuentas de admin
  // (`adminRole` no nulo), ver `recordFailedAdminLogin`/`recordSuccessfulAdminLogin`
  // en `server/data/users.ts`. Para el resto de las cuentas quedan siempre
  // en su valor por default.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Suspensión temporal por un admin — a diferencia de un ban (`isActive`),
  // el usuario SIGUE pudiendo loguearse (ve el estado y el motivo en su
  // panel); lo que cambia es que sus publicaciones dejan de ser públicas y
  // no puede publicar/reactivar mientras dure (ver `visibleStatusWhere()`/
  // `loadActivationContext()` en `server/data/listings.ts`). Se levanta
  // sola al pasar `suspendedUntil` (computado al leer, sin cron) o a mano
  // desde `/admin/usuarios`.
  suspendedUntil   DateTime?
  suspensionReason String?

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  agencyProfile        AgencyProfile?
  listings             Listing[]
  payments             Payment[]
  verificationRequests VerificationRequest[]
  adminAuditLogs       AdminAuditLog[]        @relation("AdminAuditLogs")

  @@index([accountType])
  @@index([adminRole])
  @@index([deletedAt])
}

model AgencyProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName String
  cuit         String   @unique
  description  String?
  logoUrl      String?
  // Mismo criterio que `User.avatarPositionX/Y` — punto de anclaje del
  // recorte que el usuario elige arrastrando la imagen.
  logoPositionX Int     @default(50)
  logoPositionY Int     @default(50)
  address      String?
  city         String?
  province     String?
  website      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Catálogo administrable de tipos de vehículo — Fase 1 de la migración del
// enum `VehicleType` a tabla real (ver ARCHITECTURE.md 7.2.7). En esta fase
// convive en paralelo con el enum: `Model`/`Listing` todavía usan
// `VehicleType`, no `VehicleTypeCatalog` — se conecta recién en la fase
// siguiente. `code` espeja los valores del enum viejo para que esa
// migración pueda resolver cada fila por código sin ambigüedad.
model VehicleTypeCatalog {
  id               String   @id @default(cuid())
  code             String   @unique
  label            String
  labelPlural      String
  icon             String
  mileageUnit      String?
  usesTransmission Boolean  @default(false)
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())

  models           Model[]
  listings         Listing[]
  taxonomyRequests TaxonomyRequest[]
}

model Brand {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  // "Eliminar" desde el admin es este toggle, no un DELETE físico — una
  // marca con modelos/publicaciones reales no se puede borrar sin romper
  // esas relaciones (Model tiene onDelete: Cascade contra Brand, pero
  // Listing→Model es RESTRICT). Mismo criterio reversible que ya usan
  // Plan/VehicleTypeCatalog. Dar de baja no afecta publicaciones existentes,
  // solo deja de ofrecerse como opción nueva en el wizard/filtros.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  models           Model[]
  listings         Listing[]
  taxonomyRequests TaxonomyRequest[]
}

model Model {
  id            String             @id @default(cuid())
  name          String
  slug          String
  vehicleTypeId String
  vehicleType   VehicleTypeCatalog @relation(fields: [vehicleTypeId], references: [id])
  brandId       String
  brand         Brand              @relation(fields: [brandId], references: [id], onDelete: Cascade)
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())

  versions Version[]
  listings Listing[]

  @@unique([brandId, vehicleTypeId, name])
  @@index([vehicleTypeId, brandId])
}

model Version {
  id        String   @id @default(cuid())
  modelId   String
  model     Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  listings Listing[]

  @@unique([modelId, name])
  @@index([modelId])
}

// Provincia/Localidad administrables — migración puramente aditiva (decisión
// explícita del usuario): las publicaciones viejas conservan su texto libre
// (`Listing.province`/`.city`) sin intentar vincularlas retroactivamente.
// `Province.name` espeja `PROVINCIAS` en `constants.ts` para que el botón
// "Cargar provincias registradas" del admin pueda sembrarlas en un clic.
model Province {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  localities       Locality[]
  listings         Listing[]
  localityRequests LocalityRequest[]
}

model Locality {
  id         String   @id @default(cuid())
  provinceId String
  province   Province @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  name       String
  slug       String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  listings Listing[]

  @@unique([provinceId, name])
  @@index([provinceId])
}

// Solicitud de catálogo: el usuario tipeó a mano una marca/modelo/versión que
// no está en la lista, desde el modal del wizard (Fase 7). `dedupeKey`
// (marca+modelo+versión+año normalizados: sin acentos, minúsculas, trim)
// evita que dos usuarios pidiendo lo mismo generen dos filas — la segunda
// simplemente se linkea a la solicitud ya pendiente. `brandId` se completa
// solo si la marca tecleada coincide con una ya existente (falta el
// modelo/versión nada más); si no, es `null` y se crea todo al aprobar.
// Reusa `VerificationStatus` (nunca `REJECTED` acá — el precedente de
// Identidad es "aprobar" o "dejar pendiente con nota", nunca un rechazo duro).
model TaxonomyRequest {
  id            String             @id @default(cuid())
  vehicleTypeId String
  vehicleType   VehicleTypeCatalog @relation(fields: [vehicleTypeId], references: [id])
  brandId       String?
  brand         Brand?             @relation(fields: [brandId], references: [id])
  brandName     String
  modelName     String
  versionName   String
  year          Int
  dedupeKey     String             @unique
  status        VerificationStatus @default(PENDING)
  adminNote     String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  listings Listing[]

  @@index([status])
}

/** Mismo criterio que `TaxonomyRequest`, para localidades tipeadas a mano en el modal de Ubicación del wizard. */
model LocalityRequest {
  id         String             @id @default(cuid())
  provinceId String
  province   Province           @relation(fields: [provinceId], references: [id])
  name       String
  dedupeKey  String             @unique
  status     VerificationStatus @default(PENDING)
  adminNote  String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  listings Listing[]

  @@index([status])
}

model Listing {
  id     String @id @default(cuid())
  slug   String @unique
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  vehicleTypeId String
  vehicleType   VehicleTypeCatalog @relation(fields: [vehicleTypeId], references: [id])
  // Nullable: una publicación con datos de catálogo pendientes de aprobación
  // (Fase 6/7) no tiene marca/modelo reales todavía — ver
  // `pendingBrandName`/`pendingModelName`/`pendingTaxonomyRequestId` más
  // abajo. Toda publicación NO pendiente sigue teniendo estos dos siempre
  // completos (se valida en la capa de datos, no acá).
  brandId       String?
  brand         Brand?             @relation(fields: [brandId], references: [id])
  modelId       String?
  model         Model?             @relation(fields: [modelId], references: [id])
  year          Int

  title String
  // Texto libre histórico — se mantiene sincronizado con `versionRef.name`
  // cuando el wizard resuelve una versión real de la cascada, pero sigue
  // existiendo solo, sin FK, para las publicaciones de antes de esta tabla
  // (migración puramente aditiva, no se intentó vincular datos viejos).
  version     String?
  versionId   String?
  versionRef  Version? @relation(fields: [versionId], references: [id])
  description String?

  condition    VehicleCondition  @default(USADO)
  transmission TransmissionType?

  price            Decimal  @db.Decimal(12, 2)
  currency         Currency @default(ARS)
  priceNegotiable  Boolean  @default(false)
  acceptsTrade     Boolean  @default(false)
  acceptsFinancing Boolean  @default(false)

  mileageKm      Int?
  // Texto libre histórico — se mantiene sincronizado con `provinceRef.name`/
  // `localityRef.name` cuando el wizard resuelve una ubicación real de la
  // cascada, pero sigue existiendo solo (sin FK) para publicaciones de antes
  // de estas tablas (migración puramente aditiva, mismo criterio que `version`).
  province       String?
  provinceId     String?
  provinceRef    Province? @relation(fields: [provinceId], references: [id])
  city           String?
  localityId     String?
  localityRef    Locality? @relation(fields: [localityId], references: [id])
  contactAddress String?

  // Snapshot de texto tecleado a mano en el modal "no está en la lista"
  // (Fase 7) para una marca/modelo/versión que todavía no existe en el
  // catálogo — solo tiene valor mientras `status = PENDIENTE_APROBACION` y
  // `pendingTaxonomyRequestId` no es null. Al aprobarse la solicitud
  // (`approveTaxonomyRequest`), se resuelve `brandId`/`modelId`/`versionId`
  // reales y estos campos dejan de usarse (no se borran, quedan de rastro).
  pendingBrandName         String?
  pendingModelName         String?
  pendingVersionName       String?
  pendingTaxonomyRequestId String?
  pendingTaxonomyRequest   TaxonomyRequest? @relation(fields: [pendingTaxonomyRequestId], references: [id])

  // Mismo criterio que el bloque anterior, para una localidad tecleada a
  // mano que todavía no existe en el catálogo.
  pendingLocalityName      String?
  pendingLocalityRequestId String?
  pendingLocalityRequest   LocalityRequest? @relation(fields: [pendingLocalityRequestId], references: [id])

  status        ListingStatus @default(ACTIVE)
  featured      Boolean       @default(false)
  featuredSince DateTime?
  featuredUntil DateTime?
  expiresAt     DateTime?
  publishedAt   DateTime?
  soldAt        DateTime?
  viewCount     Int           @default(0)

  // Borrado lógico desde el panel de administración — la fila sigue en la
  // base, se excluye de toda lectura pública/del dueño. Nunca se usa para
  // el borrado normal del dueño (`deleteOwnedListing`, que sigue siendo un
  // DELETE real de una publicación sin ninguna venta/reporte asociado).
  deletedAt DateTime?

  // Suspensión de una publicación puntual por un admin (motivo + días) —
  // mismo criterio 100% computado que `featured`/`featuredUntil`: nunca se
  // reescribe `status`, `getEffectiveStatus()` devuelve "SUSPENDIDA" acá
  // mientras esté vigente y se levanta sola al pasar la fecha.
  suspendedUntil   DateTime?
  suspensionReason String?

  // Datos opcionales de la venta, cargados al marcar como vendida (privados,
  // solo el dueño los ve — no se muestran en el catálogo público).
  buyerInfo      String?
  realSalePrice  Decimal? @db.Decimal(12, 2)
  saleConditions String?

  images     Image[]
  payments   Payment[]
  viewEvents ListingView[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, featured, createdAt])
  @@index([vehicleTypeId, brandId, modelId, year])
  @@index([condition])
  @@index([price])
  @@index([mileageKm])
  @@index([userId])
  @@index([deletedAt])
}

// Una fila por (publicación, visitante, día) — dedup para que `Listing.viewCount`
// cuente vistas reales: no suma más de una vez por visitante/día, sin importar
// cuántas veces refresque la página. El visitante se identifica por hash
// (userId si está logueado, o IP+user-agent si no) para no guardar la IP en
// texto plano. Ver `lib/listing-views.ts`.
model ListingView {
  id          String   @id @default(cuid())
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  visitorHash String
  viewDate    DateTime @db.Date
  createdAt   DateTime @default(now())

  @@unique([listingId, visitorHash, viewDate])
  @@index([listingId])
}

model Image {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  order     Int      @default(0)
  alt       String?
  createdAt DateTime @default(now())

  @@index([listingId])
}

/// Solicitud de verificación de identidad (foto de DNI frente/dorso). Las
/// fotos se guardan en un bucket privado de Supabase Storage (nunca público,
/// a diferencia de listing-images/avatars) — se guarda la ruta, no una URL
/// pública. Todavía no hay panel de administración para aprobar/rechazar
/// (ver ERRORES.md); queda en PENDING hasta que se revise manualmente.
model VerificationRequest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName String
  dni      String
  phone    String

  dniFrontPath String
  dniBackPath  String

  status VerificationStatus @default(PENDING)
  /// Observación del admin cuando hay inconsistencias — la solicitud sigue
  /// PENDING (no es un rechazo definitivo), se sobrescribe en cada revisión.
  adminNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

/// Estructura lista para Mercado Pago; integración real pendiente (ver ARCHITECTURE.md).
model Plan {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  description  String?
  price        Decimal  @db.Decimal(12, 2)
  durationDays Int?
  /// Solo para packs de publicaciones (código PUBLICATIONS_PACK_*): cuántas
  /// publicaciones suma al comprarlo. Null para el resto de los planes.
  quantity     Int?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}


model Payment {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId         String?
  listing           Listing?      @relation(fields: [listingId], references: [id])
  planCode          String
  amount            Decimal       @db.Decimal(12, 2)
  currency          Currency      @default(ARS)
  status            PaymentStatus @default(PENDING)
  provider          String        @default("mercadopago")
  // Único (nulos permitidos, Postgres no los considera duplicados): base para
  // la idempotencia del webhook real de Mercado Pago — un reintento con el
  // mismo ID de pago del proveedor no puede acreditar cupo dos veces, el
  // segundo `create()` va a fallar por esta constraint.
  providerPaymentId String?       @unique
  description       String
  // Efecto a aplicar cuando el webhook confirme el pago (qué publicaciones/
  // días destacar, o la elección del combo) — el pago se crea PENDING sin
  // acreditar nada; `applyPaymentEffect` lee esto recién cuando Mercado Pago
  // avisa que se aprobó. Los planes sin líneas (pack/suscripción) no la usan,
  // el efecto sale de `Plan` por `planCode`.
  metadata          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([userId, status])
}

/// Registro de auditoría del panel de administración — una fila por cada
/// acción de un admin (banear, borrar lógicamente, otorgar suscripción,
/// destacar/quitar destacado, cambiar el rol de otro admin, etc). Se escribe
/// explícitamente desde cada Server Action de `/admin` (ver
/// `server/data/admin/audit-log.ts`), nunca vía hook automático de Prisma.
model AdminAuditLog {
  id          String   @id @default(cuid())
  adminId     String
  admin       User     @relation("AdminAuditLogs", fields: [adminId], references: [id])
  action      String
  targetTable String
  targetId    String
  /// { before: {...}, after: {...} }
  changes     Json?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([adminId])
  @@index([targetTable, targetId])
  @@index([createdAt])
}
