generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  PARTICULAR
  AGENCIA
  CONCESIONARIA
}

enum VehicleType {
  AUTO
  CAMIONETA
  MOTO
  BICICLETA
  MONOPATIN
  LANCHA
  BARCO
}

enum ListingStatus {
  DRAFT
  ACTIVE
  RESERVADA
  PAUSADA
  EXPIRED
  SOLD
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Currency {
  ARS
  USD
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VehicleCondition {
  NUEVO
  USADO
}

enum TransmissionType {
  MECANICA
  ASISTIDA
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  accountType  AccountType
  fullName     String
  dni          String      @unique
  phone        String
  avatarUrl    String?
  isActive     Boolean     @default(true)
  lastLoginAt  DateTime?

  // Se incrementa cada vez que una publicación del usuario pasa a estado
  // ACTIVE (alta o reactivación). Junto con `purchasedPublications` define el
  // cupo disponible: FREE_PUBLICATION_QUOTA + purchasedPublications -
  // activationCount (ver `server/data/listings.ts`).
  activationCount        Int     @default(0)
  purchasedPublications  Int     @default(0)
  isVerified             Boolean @default(false)

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  agencyProfile        AgencyProfile?
  listings             Listing[]
  paymentMethods       PaymentMethod[]
  payments             Payment[]
  verificationRequests VerificationRequest[]

  @@index([accountType])
}

model AgencyProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName String
  cuit         String   @unique
  description  String?
  logoUrl      String?
  address      String?
  city         String?
  province     String?
  website      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Brand {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  createdAt DateTime @default(now())

  models   Model[]
  listings Listing[]
}

model Model {
  id          String      @id @default(cuid())
  name        String
  slug        String
  vehicleType VehicleType
  brandId     String
  brand       Brand       @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())

  listings Listing[]

  @@unique([brandId, vehicleType, name])
  @@index([vehicleType, brandId])
}

model Listing {
  id     String @id @default(cuid())
  slug   String @unique
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  vehicleType VehicleType
  brandId     String
  brand       Brand       @relation(fields: [brandId], references: [id])
  modelId     String
  model       Model       @relation(fields: [modelId], references: [id])
  year        Int

  title       String
  version     String?
  description String?

  condition    VehicleCondition  @default(USADO)
  transmission TransmissionType?

  price            Decimal  @db.Decimal(12, 2)
  currency         Currency @default(ARS)
  priceNegotiable  Boolean  @default(false)
  acceptsTrade     Boolean  @default(false)
  acceptsFinancing Boolean  @default(false)

  mileageKm      Int?
  province       String?
  city           String?
  contactAddress String?

  status        ListingStatus @default(ACTIVE)
  featured      Boolean       @default(false)
  featuredUntil DateTime?
  expiresAt     DateTime?
  publishedAt   DateTime?
  soldAt        DateTime?
  viewCount     Int           @default(0)

  // Datos opcionales de la venta, cargados al marcar como vendida (privados,
  // solo el dueño los ve — no se muestran en el catálogo público).
  buyerInfo      String?
  realSalePrice  Decimal? @db.Decimal(12, 2)
  saleConditions String?

  images   Image[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, featured, createdAt])
  @@index([vehicleType, brandId, modelId, year])
  @@index([condition])
  @@index([price])
  @@index([mileageKm])
  @@index([userId])
}

model Image {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  order     Int      @default(0)
  alt       String?
  createdAt DateTime @default(now())

  @@index([listingId])
}

/// Solicitud de verificación de identidad (foto de DNI frente/dorso). Las
/// fotos se guardan en un bucket privado de Supabase Storage (nunca público,
/// a diferencia de listing-images/avatars) — se guarda la ruta, no una URL
/// pública. Todavía no hay panel de administración para aprobar/rechazar
/// (ver ERRORES.md); queda en PENDING hasta que se revise manualmente.
model VerificationRequest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName String
  dni      String
  phone    String

  dniFrontPath String
  dniBackPath  String

  status VerificationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

/// Estructura lista para Mercado Pago; integración real pendiente (ver ARCHITECTURE.md).
model Plan {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  description  String?
  price        Decimal  @db.Decimal(12, 2)
  durationDays Int?
  /// Solo para packs de publicaciones (código PUBLICATIONS_PACK_*): cuántas
  /// publicaciones suma al comprarlo. Null para el resto de los planes.
  quantity     Int?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model PaymentMethod {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String   @default("mercadopago")
  label     String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Payment {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId         String?
  listing           Listing?      @relation(fields: [listingId], references: [id])
  planCode          String
  amount            Decimal       @db.Decimal(12, 2)
  currency          Currency      @default(ARS)
  status            PaymentStatus @default(PENDING)
  provider          String        @default("mercadopago")
  providerPaymentId String?
  description       String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([userId, status])
}
